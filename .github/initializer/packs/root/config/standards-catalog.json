{
  "schemaVersion": "1.0",
  "description": "Canonical catalog of standards layers, rule groups, and file ownership for the universal standards model.",
  "layers": {
    "common": {
      "description": "Cross-client rules that always apply.",
      "scope": [
        "all-clients",
        "all-domains",
        "all-capabilities"
      ],
      "files": [
        {
          "path": "docs/standards/common/markdown-output-standards.md",
          "purpose": "Markdown structure, clarity, and output formatting baseline"
        },
        {
          "path": "docs/standards/common/prompt-writing-standards.md",
          "purpose": "Prompt construction, response quality, and instruction hygiene"
        },
        {
          "path": "docs/standards/common/security-baseline.md",
          "purpose": "Cross-client security and privacy baseline"
        },
        {
          "path": "docs/standards/common/capability-governance-baseline.md",
          "purpose": "Cross-capability normative language, exception policy, and quality gate baseline"
        }
      ]
    },
    "domains": {
      "description": "Workflow-specific standards that are independent of implementation stack.",
      "entries": [
        {
          "id": "ba",
          "description": "Business analysis outputs and transformations",
          "files": [
            "docs/standards/domains/ba/README.md"
          ],
          "appliesTo": [
            "functional-requirements",
            "gap-analysis",
            "user-stories",
            "reverse-engineer-analysis",
            "ui-analysis"
          ]
        },
        {
          "id": "bpmn",
          "description": "Workflow modeling and BPMN derivation",
          "files": [
            "docs/standards/domains/bpmn/cascade2_bpmn_standards.md"
          ],
          "appliesTo": [
            "bpmn-analysis",
            "bpmn-derivation",
            "bpmn-generation",
            "bpmn-review"
          ]
        },
        {
          "id": "qa",
          "description": "Testing and validation-oriented outputs",
          "files": [
            "docs/standards/domains/qa/RULES.md"
          ],
          "appliesTo": [
            "bug-report",
            "automation-scripts",
            "test-case-design",
            "failure-triage"
          ]
        },
        {
          "id": "db",
